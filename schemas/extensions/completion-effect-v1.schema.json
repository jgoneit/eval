  "$id": "urn:jgoneit:eval:extension:completion-effect:v1",
  "title": "Eval completion task effect v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "values"],
  "properties": {
    "schema_version": {"const": "completion-effect/v1"},
